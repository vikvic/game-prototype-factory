# Documentation only: the factory does not automatically load .env files.
# Set this in the worker's environment if you want Discord notifications.
DISCORD_WEBHOOK_URL=
# Deployment only: use GitHub environment secrets, never builder/game inputs.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional future server-side reporting; never embed this private key in pages.
PLAUSIBLE_API_KEY=
